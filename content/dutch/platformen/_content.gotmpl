{{/* Maakt een pagina voor elk platform uit data/platform_rapporten.yaml, behalve
     de gedeelde websites. De beschrijving komt uit data/platform_profielen.yaml.
     Een platform zonder beschrijving krijgt een pagina met een plek voor tekst,
     maar blijft uit de zoekmachines tot de beschrijving er is.
     Profielen met voorbeeld: true worden alleen op de lokale server gebouwd. */}}
{{ $profielen := hugo.Data.platform_profielen.profielen | default slice }}
{{ range where hugo.Data.platform_rapporten.rapporten "categorie" "ne" "Gedeelde websites en samenwerkingen" }}
  {{ $profiel := dict }}
  {{ range first 1 (where $profielen "platform" .platform) }}{{ $profiel = . }}{{ end }}
  {{ if or (not $profiel.voorbeeld) (not hugo.IsProduction) }}
    {{ $slug := partial "platform-slug.html" (dict "platform" .platform) }}
    {{ $zonderTekst := not $profiel.samenvatting }}
    {{ $verbergen := or $zonderTekst ($profiel.voorbeeld | default false) }}
    {{ $params := dict
      "platform" .platform
      "meta_title" (printf "%s: toegankelijkheid en rapport | Proper Access" .platform)
      "description" (printf "Hoe toegankelijk is %s? Rapportdatum, geldigheid, afgekeurde succescriteria en de Logius-checklist van het technische rapport." .platform)
      "noindex" $verbergen
      "sitemap_exclude" $verbergen
    }}
    {{ $.AddPage (dict
      "path" $slug
      "kind" "page"
      "title" .platform
      "params" $params
    ) }}
  {{ end }}
{{ end }}
