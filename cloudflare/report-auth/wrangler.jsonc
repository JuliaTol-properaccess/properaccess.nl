{
  "name": "properaccess-report-auth",
  "main": "src/worker.js",
  "compatibility_date": "2026-06-01",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "www.properaccess.nl/rapporten/202606_bijenkorf_ios/*",
      "zone_name": "properaccess.nl"
    },
    {
      "pattern": "www.properaccess.nl/rapporten/202606_debijenkorf.nl/*",
      "zone_name": "properaccess.nl"
    }
  ],
  "vars": {
    "AUTH_USER": "bijenkorf",
    "REALM": "Proper Access rapport (Bijenkorf)"
  }
}
