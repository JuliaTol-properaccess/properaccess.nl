<div class="bg-body">
  {{ $image:= .Params.image }}
  {{ if $image }}
    {{ partial "image" (dict "Src" $image "Context" .Page "Alt" .Title "Class" "mb-6 w-full rounded") }}
  {{ else }}
    {{/* Posts zonder eigen afbeelding krijgen een aquarel-placeholder.
         Deterministisch per post gekozen, zodat de grid afwisselt maar stabiel blijft. */}}
    {{ $placeholders := slice
      "pa-placeholder-1-browser"
      "pa-placeholder-2-form"
      "pa-placeholder-3-keyboard"
      "pa-placeholder-4-magnifier"
      "pa-placeholder-5-checklist" }}
    {{ $idx := mod (hash.FNV32a .RelPermalink) (len $placeholders) }}
    {{ $src := printf "images/blog/placeholders/%s.webp" (index $placeholders $idx) }}
    <img src="{{ $src | relURL }}" alt="" class="mb-6 w-full rounded" loading="lazy" />
  {{ end }}
  {{ with .Params.categories }}
    {{ $slug := index . 0 | urlize | lower }}
    {{ $catPage := site.GetPage (printf "/categories/%s" $slug) }}
    {{ $label := index . 0 | humanize }}
    {{ if $catPage }}{{ $label = $catPage.Title }}{{ end }}
    <p class="blog-card__cat">{{ $label }}</p>
  {{ end }}
  <h2 class="mb-3 h4">
    <a href="{{ .RelPermalink }}">
      {{ .Title }}
    </a>
  </h2>
  <p class="mb-6">{{ .Summary | plainify }}</p>
  <div class="blog-byline blog-byline--card">
    {{ partial "image" (dict "Src" "images/julia.webp" "Alt" "" "Class" "blog-byline__photo") }}
    <div class="blog-byline__text">
      <span class="blog-byline__name">Julia Tol</span>
      <span class="blog-byline__meta">{{ .ReadingTime }} {{ i18n "reading_time" }}</span>
    </div>
  </div>
</div>
